{
  "name": "nextresume",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --experimental-strip-types --test \"tests/*.test.mjs\"",
    "test:content": "node --experimental-strip-types --test tests/resume-content.test.mjs",
    "test:pdf": "node --experimental-strip-types tests/pdf-export-smoke.mjs",
    "test:ats": "node --experimental-strip-types --test tests/ats-score.test.mjs",
    "eval": "node --experimental-strip-types scripts/eval-ats.mjs --jds ./eval/jds --resumes ./eval/resumes",
    "eval:rewrite": "node --experimental-strip-types scripts/eval-ats.mjs --jds ./eval/jds --resumes ./eval/resumes --rewrite",
    "lint": "next lint",
    "deploy": "bash scripts/deploy.sh",
    "run": "bash scripts/run.sh",
    "run:prod": "bash scripts/run.sh --prod",
    "run:clean": "bash scripts/run.sh --clean",
    "eval:content": "node --experimental-strip-types scripts/eval-content.mjs --live",
    "test:content-ui": "node --experimental-strip-types tests/content-quality-ui.mjs",
    "eval:harness": "node --experimental-strip-types scripts/eval-harness.mjs",
    "eval:refinement": "node --experimental-strip-types scripts/eval-refinement.mjs",
    "eval:uplift": "node --experimental-strip-types scripts/eval-uplift.mjs",
    "eval:uplift:summary": "node --experimental-strip-types scripts/summarize-uplift.mjs",
    "test:uplift-ui": "node --experimental-strip-types tests/uplift-review-ui.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.20",
    "@napi-rs/canvas": "^1.0.6",
    "@react-pdf/renderer": "^4.5.1",
    "@sparticuz/chromium": "^149.0.0",
    "@upstash/redis": "^1.38.0",
    "@vercel/postgres": "^0.10.0",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.12.0",
    "next": "^15.5.19",
    "openai": "^6.45.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^5.7.284",
    "puppeteer": "^25.4.0",
    "puppeteer-core": "^25.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
